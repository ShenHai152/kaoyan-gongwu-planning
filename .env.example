# Copy to `.env` and fill in. `.env` is gitignored; `.env.example` is committed.
# Real environment variables override this file (see backend/app/config.py).

# --- Database -------------------------------------------------------------
# Default is a local SQLite file created by the ETL loaders (backend/exam.db).
# EXAM_DATABASE_URL=sqlite:///./exam.db
# EXAM_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/exam

# --- LLM provider ---------------------------------------------------------
# Unset => the AI report falls back to the template and says so in the UI.
# Anthropic wins when both are set.
#
# Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
#
# OpenAI-compatible (OpenAI, DeepSeek, Tongyi, ...):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Example: DeepSeek
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com/v1
